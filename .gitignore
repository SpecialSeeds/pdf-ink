# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# The repo doubles as a test vault: these are local scratch, not sources.
.obsidian/
# A symlink pointing at this repo, so Obsidian can load it as a plugin.
/pdf-ink
# Sample PDFs used for manual testing, and the annotations made on them.
*.pdf
*.ink.json
*.ink.json.bak
*.ink.json.tmp
