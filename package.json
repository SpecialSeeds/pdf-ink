{
	"name": "pdf-ink",
	"version": "0.7.1",
	"description": "Annotate PDFs with a pen in Obsidian, without modifying the original file.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"import-onenote": "jiti tools/onenote-pdf-import/cli.ts"
	},
	"keywords": [],
	"license": "0-BSD",
	"engines": {
		"node": ">=22"
	},
	"author": "specialseeds",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/specialseeds/pdf-ink.git"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@pdf-lib/fontkit": "^1.1.1",
		"@types/node": "^22.15.17",
		"esbuild": "0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"pdfjs-dist": "^6.4.299",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"pdf-lib": "^1.17.1",
		"perfect-freehand": "^1.2.3"
	}
}
